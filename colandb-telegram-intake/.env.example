# COL&B Telegram Event Intake: settings that are secrets.
# Placeholders only. Put the real values in wp-config.php (define(...)) or in
# the host's environment variables / secret manager. Never commit real values.

# Bot token from @BotFather.
COLANDB_TG_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather

# Random string, 32-256 characters of A-Z a-z 0-9 _ -  (e.g. openssl rand -hex 32).
# Telegram sends it in X-Telegram-Bot-Api-Secret-Token with every webhook call.
COLANDB_TG_WEBHOOK_SECRET=replace-with-64-random-hex-characters

# Claude API key (console.anthropic.com), from a workspace with a spend limit.
COLANDB_INTAKE_ANTHROPIC_KEY=sk-ant-replace-me

# Test kit only: point the plugin at fake servers. Leave unset on real sites.
# COLANDB_TG_API_BASE=http://127.0.0.1:8898
# COLANDB_INTAKE_ANTHROPIC_BASE=http://127.0.0.1:8898
